APP_NAME="BP2TL Jakarta"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ---- Database BARU (dipakai aplikasi Laravel) ----
# Buat database kosong ini dulu lewat phpMyAdmin (collation utf8mb4_unicode_ci).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bp2tl_laravel
DB_USERNAME=root
DB_PASSWORD=

# ---- Database LAMA (hanya dibaca oleh `php artisan bp2tl:impor-data-lama`) ----
# Isi dengan database bp2tl_db yang sekarang dipakai aplikasi PHP native.
# Server/user/password mengikuti DB_* di atas kecuali Anda isi sendiri di sini.
LEGACY_DB_DATABASE=bp2tl_db
# LEGACY_DB_HOST=127.0.0.1
# LEGACY_DB_USERNAME=root
# LEGACY_DB_PASSWORD=

# Sesi/cache memakai file supaya tidak butuh tabel tambahan.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
